{
  "manifestVersion": 5,
  "id": "spaceweekly.premiere.offline",
  "name": "SpaceWeekly Premiere",
  "version": "0.1.0",
  "main": "index.html",
  "host": { "app": "premierepro", "minVersion": "26.0.0" },
  "requiredPermissions": { "localFileSystem": "request" },
  "entrypoints": [
    {
      "type": "panel",
      "id": "spaceweekly",
      "label": { "default": "SpaceWeekly" },
      "minimumSize": { "width": 340, "height": 460 },
      "preferredDockedSize": { "width": 380, "height": 600 },
      "preferredFloatingSize": { "width": 420, "height": 620 }
    }
  ]
}
