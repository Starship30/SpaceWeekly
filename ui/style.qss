QWidget { background: $window_bg; color: $text; }
QMainWindow, QDialog { background: $window_bg; }
QLabel { background: transparent; }
QLabel#HeroTitle { font-size: 26px; font-weight: 700; }
QLabel#BrandTitle { font-size: 16px; font-weight: 700; letter-spacing: 2px; padding: 8px 18px 8px 4px; color: $accent; }
QLabel#Eyebrow { color: $text_muted; font-size: 11px; letter-spacing: 1px; }
QLabel#PanelTitle { font-size: 19px; font-weight: 700; }
QLabel#SectionTitle { font-size: 14px; font-weight: 600; }
QWidget#SettingsCard, QWidget#WorkspacePanel {
    background: $panel_bg; border: 1px solid $border; border-radius: 16px;
}
QFrame#SubtlePanel { background: $panel_alt_bg; border: 1px solid $border; border-radius: 12px; }
QWidget#DashboardControls { background: $panel_bg; }
QToolBar { background: $panel_bg; border: none; border-bottom: 1px solid $border; spacing: 8px; padding: 12px 20px; }
QToolButton { background: transparent; border: none; padding: 9px 12px; border-radius: 8px; font-weight: 600; }
QToolButton:hover { background: $control_hover_bg; color: $accent; }
QToolButton:disabled { color: $text_subtle; }
QToolBar::separator { background: $border; width: 1px; margin: 8px; }
QSplitter::handle { background: $window_bg; }
QListWidget, QTextEdit, QPlainTextEdit, QLineEdit, QSpinBox, QDoubleSpinBox, QComboBox, QDateEdit {
    background: $control_bg; border: 1px solid $border_strong; border-radius: 8px;
    padding: 9px 12px; selection-background-color: $accent; selection-color: $selection_text;
}
QLineEdit, QSpinBox, QDoubleSpinBox, QComboBox, QDateEdit { min-height: 20px; }
QLineEdit:focus, QComboBox:focus, QDateEdit:focus, QSpinBox:focus, QDoubleSpinBox:focus, QTextEdit:focus, QPlainTextEdit:focus { border: 1px solid $accent; }
QLineEdit:disabled, QComboBox:disabled, QDateEdit:disabled, QSpinBox:disabled, QDoubleSpinBox:disabled { background: $panel_alt_bg; color: $text_subtle; border-color: $border; }
QTextEdit, QPlainTextEdit { background: $panel_bg; }
QListWidget { padding: 6px; }
QListWidget::item { background: transparent; border-radius: 8px; padding: 11px 10px; }
QListWidget::item:hover { background: $control_hover_bg; }
QListWidget::item:selected { background: $control_hover_bg; color: $accent; font-weight: 600; }
QListWidget#SettingsNav { background: $sidebar_bg; border: 1px solid $border; border-radius: 14px; padding: 8px; }
QListWidget#SettingsNav::item { padding: 14px 16px; }
QListWidget#SettingsNav::item:hover { background: $control_bg; }
QListWidget#SettingsNav::item:selected { background: $accent; color: $selection_text; }
QComboBox::drop-down, QDateEdit::drop-down { border: none; width: 28px; }
QComboBox QAbstractItemView { background: $panel_bg; color: $text; border: 1px solid $border; selection-background-color: $accent; selection-color: $selection_text; padding: 6px; }
QCheckBox, QRadioButton { background: transparent; spacing: 9px; padding: 4px 0; }
QCheckBox::indicator { width: 17px; height: 17px; border: 1px solid $border_strong; border-radius: 5px; background: $control_bg; }
QCheckBox::indicator:checked { background: $accent; border-color: $accent; image: url($check_icon); }
QRadioButton::indicator { width: 16px; height: 16px; border: 1px solid $border_strong; border-radius: 9px; background: $control_bg; }
QRadioButton::indicator:checked { border: 5px solid $accent; width: 8px; height: 8px; }
QRadioButton[rangeOption="true"] { background: $panel_alt_bg; border: 1px solid $border; border-radius: 9px; padding: 12px 20px; font-weight: 600; }
QRadioButton[rangeOption="true"]::indicator { width: 0; height: 0; border: none; }
QRadioButton[rangeOption="true"]:checked { background: $accent; border-color: $accent; color: $selection_text; }
QRadioButton[rangeOption="true"]:focus { border: 2px solid $accent_hover; }
QPushButton { background: $control_bg; border: 1px solid $border_strong; border-radius: 8px; min-height: 24px; padding: 8px 14px; font-weight: 600; }
QPushButton:hover { background: $control_hover_bg; border-color: $accent; }
QPushButton:pressed { background: $control_pressed_bg; }
QPushButton:focus { border-color: $accent; }
QPushButton:disabled { background: $panel_alt_bg; color: $text_subtle; border-color: $border; }
QPushButton#PrimaryButton { background: $primary; border-color: $primary_border; color: $on_primary; min-width: 120px; }
QPushButton#PrimaryButton:hover { background: $primary_hover; }
QPushButton#PrimaryButton:disabled { background: $panel_alt_bg; color: $text_subtle; border-color: $border; }
QStatusBar { background: $panel_bg; border-top: 1px solid $border; padding: 6px 14px; }
QStatusBar QLabel { color: $text_muted; }
QStatusBar::item { border: none; }
QScrollArea { background: transparent; border: none; }
QScrollBar:vertical { background: transparent; width: 8px; margin: 3px 0; }
QScrollBar::handle:vertical { background: $border_strong; border-radius: 4px; min-height: 32px; }
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical { height: 0; }
QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical { background: transparent; }
QToolTip { background: $panel_bg; color: $text; border: 1px solid $border; padding: 6px; }

QListWidget { outline: 0; }
QAbstractItemView::indicator { width: 17px; height: 17px; border: 1px solid $border_strong; border-radius: 5px; background: $control_bg; }
QAbstractItemView::indicator:checked { image: url($check_icon); background: $accent; border-color: $accent; }
QComboBox::down-arrow, QDateEdit::down-arrow { image: url($arrow_down); width: 16px; height: 16px; }
QSpinBox::up-button, QDoubleSpinBox::up-button { subcontrol-origin: border; subcontrol-position: top right; width: 24px; border: none; background: transparent; }
QSpinBox::down-button, QDoubleSpinBox::down-button { subcontrol-origin: border; subcontrol-position: bottom right; width: 24px; border: none; background: transparent; }
QSpinBox::up-arrow, QDoubleSpinBox::up-arrow { image: url($arrow_up); width: 12px; height: 12px; }
QSpinBox::down-arrow, QDoubleSpinBox::down-arrow { image: url($arrow_down); width: 12px; height: 12px; }

QWidget[formGroup="true"] { background: transparent; }

QFrame#ComboPopup { background: $panel_bg; border: 1px solid $border_strong; border-radius: 12px; padding: 4px; }
QFrame#ComboPopup QWidget { background: $panel_bg; }
QComboBox QAbstractItemView { background: $panel_bg; border: none; border-radius: 10px; padding: 6px; outline: 0; }
QComboBox QAbstractItemView::item { border: none; border-radius: 8px; padding: 8px 12px; min-height: 20px; }
QComboBox QAbstractItemView::item:selected { background: $accent; color: $selection_text; }
QComboBox QAbstractItemView::item:hover,
QComboBox QAbstractItemView::item:selected:active,
QComboBox QAbstractItemView::item:selected:!active { background: $accent; color: $selection_text; }

QProgressBar#VideoProgress { background: $panel_alt_bg; border: 1px solid $border; border-radius: 6px; min-height: 14px; text-align: center; font-size: 11px; }
QProgressBar#VideoProgress::chunk { background: $accent; border-radius: 5px; }
QSlider#VideoPreviewSlider::groove:horizontal { background: $border; height: 4px; border-radius: 2px; }
QSlider#VideoPreviewSlider::sub-page:horizontal { background: $accent; border-radius: 2px; }
QSlider#VideoPreviewSlider::handle:horizontal { background: $panel_bg; border: 2px solid $accent; width: 12px; margin: -6px 0; border-radius: 7px; }
